# .env for the staging copy in /opt/camwatch-staging (extras/release.sh staging creates it from this file).
# Same image and code as production, a fake camera, nothing that reaches the outside world.
COMPOSE_PROJECT_NAME=camwatch-staging
COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml
CAMWATCH_IMAGE=camwatch:staging
CAMWATCH_PREFIX=camwatch-staging

CAMERA_NAME=fakecam
RTSP_URL=rtsp://fakecam:8554/cam
DETECT_MODE=motion
TZ=Europe/Berlin

# on the data disk, next to production's folders (the system disk also holds production's video buffer)
RECORDINGS_PATH=/srv/camwatch/staging/recordings
PHOTOS_PATH=/srv/camwatch/staging/photos
DATA_PATH=/srv/camwatch/staging/data
RETENTION_DAYS=2
RETENTION_KEEP_DAYS=2
MIN_FREE_GB=2

WEB_PORT=8090
WEB_BASE_URL=http://192.168.1.81:8090
WEB_USER=admin
WEB_PASSWORD=staging

# no pushes, no Home Assistant, no off-site uploads from staging
NTFY_TOPIC=
MQTT_HOST=
HA_WEBHOOK_URL=
SEARCH_ENABLED=false
