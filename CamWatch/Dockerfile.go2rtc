FROM golang:1.23-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates wget && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN wget -qO- https://github.com/aler9/go2rtc/archive/refs/heads/master.tar.gz | tar xz --strip-components=1 go2rtc-master && go build -o /go2rtc .

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /go2rtc /usr/local/bin/go2rtc
RUN chmod +x /usr/local/bin/go2rtc

ENTRYPOINT ["go2rtc"]
