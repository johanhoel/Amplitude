# Copy to .env and edit. Lines marked REQUIRED must be changed.

# ---------- Camera ----------
# The first camera. Up to 3 more are added on the web UI's Settings page (Cameras), which can also change these URLs.
CAMERA_NAME=frontdoor
# REQUIRED. Main (high-res) stream, recorded without re-encoding
RTSP_URL=rtsp://CHANGE_ME:password@192.168.1.50:554/stream1
# Optional low-res substream for motion detection (much less CPU). Empty = use RTSP_URL
DETECT_URL=
TZ=Etc/UTC
# Set to false if the camera's audio causes trouble
RECORD_AUDIO=true

# ---------- Paths on the LXC host ----------
RECORDINGS_PATH=/mnt/hdd/camwatch/recordings
PHOTOS_PATH=/mnt/hdd/camwatch/photos
DATA_PATH=/mnt/hdd/camwatch/data

# ---------- ntfy ----------
# Starting values: once saved on the web UI's Settings page (Notifications), those are used.
NTFY_URL=https://ntfy.sh
# REQUIRED. On public ntfy.sh anyone who guesses the topic can read it - make it long and random
NTFY_TOPIC=CHANGE_ME
# Either a token (tk_...) or user/password if your ntfy server requires auth
NTFY_TOKEN=
NTFY_USER=
NTFY_PASSWORD=
NTFY_PRIORITY=high
# Optional separate topic for health messages (camera offline, recording stalled, backup failed). Empty = NTFY_TOPIC
NTFY_STATUS_TOPIC=
NOTIFY_SNAPSHOT=true
NOTIFY_COOLDOWN_SECONDS=60
# Alert snapshots are scaled to this width (smaller = push arrives sooner)
NOTIFY_WIDTH=1280

# ---------- Motion detection ----------
DETECT_FPS=5
# Fraction of the frame that must change (0.01 = 1%)
MOTION_MIN_AREA=0.01
# Bigger whole-frame changes are treated as lighting/IR switches and ignored
MOTION_MAX_AREA=0.60
# Per-pixel brightness change that counts as motion (higher = less sensitive)
MOTION_PIXEL_THRESHOLD=25
# Consecutive motion frames before an event starts
MOTION_MIN_FRAMES=3
# Legacy: imported once into the web UI's Zones page, then ignored. Edit zones there.
# Areas to ignore (trees, road, timestamp overlay): polygons of normalised x,y points, separated by ;
# e.g. MOTION_MASK=0,0 1,0 1,0.08 0,0.08
MOTION_MASK=

# ---------- Object detection ----------
# objects = motion must be confirmed as one of DETECT_OBJECTS by YOLO (needs models/yolov8n.onnx)
# motion  = any motion triggers
DETECT_MODE=objects
# Comma-separated COCO classes, e.g. person,car,dog,cat,bicycle,motorcycle
DETECT_OBJECTS=person,car,truck,motorcycle,bicycle,dog,cat
# Full 80-class model (yolov8n.onnx is person-only)
OBJECT_MODEL=/models/yolov8s-coco.onnx
# Vehicles that stay put this long (parked car) stop triggering. People/animals are never ignored
STATIONARY_SECONDS=30
OBJECT_CONFIDENCE=0.5
# Ignore detections smaller than this fraction of the frame
OBJECT_MIN_AREA=0.002
# YOLO hits needed within the last OBJECT_WINDOW passes (OBJECT_INTERVAL s apart) before an event starts
OBJECT_MIN_HITS=2
OBJECT_WINDOW=3
OBJECT_INTERVAL=0.2
# In objects mode, motion this small (fraction of frame) makes YOLO look. Default: half of OBJECT_MIN_AREA
# MOTION_GATE_AREA=0.001
# Push "camera offline" if no picture for this long
OFFLINE_AFTER_SECONDS=120
# Alert + restart the recording stream when no video has been written for this long
RECORDING_STALL_SECONDS=60

# ---------- Number plates ----------
# Read plates of moving vehicles (needs car/truck/motorcycle in DETECT_OBJECTS)
PLATE_READING=true
# Push for: all | unknown | none (known plates are sent at low priority)
PLATE_NOTIFY=all
# Minimum plate detector / OCR confidence
PLATE_MIN_DETECT=0.5
PLATE_MIN_OCR=0.8

# ---------- Recording ----------
PRE_ROLL_SECONDS=5
POST_ROLL_SECONDS=10
MAX_EVENT_SECONDS=300
RETENTION_DAYS=30
# Clips where someone was identified or tagged. Starred clips are never auto-deleted
RETENTION_KEEP_DAYS=90
# Oldest recordings are deleted when free space on the HDD drops below this
MIN_FREE_GB=20

# ---------- Face matching (offline) ----------
# Cosine similarity needed to call it a match. Raise (0.45-0.5) if you get false matches
FACE_MATCH_THRESHOLD=0.40
FACE_SAMPLE_FPS=4
FACE_MIN_SIZE=40
# How often to look for new clips, and how old a clip must be before analysis
FACE_SCAN_INTERVAL=10
FACE_SETTLE_SECONDS=5
# Re-check clips with faces when reference photos change (debounced)
FACE_RECHECK_ON_LIBRARY_CHANGE=true
FACE_RECHECK_DELAY=60
FACE_MIN_HITS=1
# Only process in these hours, e.g. 1-6 for overnight. Empty = shortly after each recording
FACE_ACTIVE_HOURS=
FACE_NOTIFY_KNOWN=true
# Quieter alerts for the household: hold a person alert up to HOUSEHOLD_WAIT_SECONDS while faces are checked.
# Only known faces -> quiet push (silent = no sound at all); unknown / no face -> normal alert. normal = always alert at once
HOUSEHOLD_ALERTS=quiet
HOUSEHOLD_WAIT_SECONDS=3
# Comma-separated names counted as household (empty = everyone in the photo library)
HOUSEHOLD=
# Recurring strangers page: unknown faces of the last N days grouped by similarity
STRANGER_DAYS=30
STRANGER_SIMILARITY=0.45
# Search recordings by description (CLIP). false = no search model loaded
SEARCH_ENABLED=true
SEARCH_FRAMES=3
# People / vehicles / animals per frame also indexed as their own image (finds small details). 0 = whole frames only
SEARCH_OBJECTS=4
FACE_NOTIFY_UNKNOWN=false

# ---------- Home Assistant ----------
# Normally set on the web UI's Settings page (that wins once saved); these are only the starting values.
# MQTT with auto-discovery (Mosquitto add-on). Empty MQTT_HOST = disabled
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# Or/also: POST every event as JSON to a Home Assistant webhook trigger
HA_WEBHOOK_URL=

# ---------- Web UI ----------
WEB_PORT=8080
# Address your phone uses to reach the web UI; ntfy notifications link to clips here
WEB_BASE_URL=http://192.168.1.10:8080
# Set a password to require login (user defaults to admin)
WEB_USER=admin
WEB_PASSWORD=
# Starting value for the trusted networks list on the Settings page (Login), used by the "No password required on the LAN" setting (requests through a proxy never count)
LAN_NETWORKS=192.168.0.0/16,10.0.0.0/8

# Off-site storage is set up on the Settings page; this is when the nightly upload starts
OFFSITE_BATCH_AT=03:30

LOG_LEVEL=INFO

# ---------- Presence log (MariaDB on the host, via its socket) ----------
DB_NAME=camwatch
DB_USER=camwatch
# REQUIRED for the presence log / Log page
DB_PASSWORD=
PRESENCE_SCAN_INTERVAL=15
# Cars arriving / leaving a parking zone: how often to look, and how long a change must hold
PARKING_CHECK_SECONDS=5
PARKING_CONFIRM_SECONDS=20
# Nightly database dumps kept by extras/db-backup.sh
DB_BACKUP_KEEP_DAYS=14

# ---------- Package detection (draw a "package" zone on the doorstep) ----------
# Quiet time before judging, how long a new object must stay, its size range (fraction of the zone),
# and how big a brightness / colour change counts. Tune if shadows are reported or small parcels missed.
PACKAGE_QUIET_SECONDS=20
PACKAGE_CONFIRM_SECONDS=60
PACKAGE_MIN_AREA=0.04
PACKAGE_MAX_AREA=0.6
PACKAGE_DIFF=45
PACKAGE_CHROMA=12

# ---------- Weekly report push ----------
# "<day> HH:MM", e.g. "sun 20:00". Empty = off (the /report page works either way)
WEEKLY_SUMMARY=sun 20:00

# ---------- Timelapse + highlights ----------
# A picture every N seconds; built nightly at TIMELAPSE_BUILD_AT into a ~TIMELAPSE_SECONDS video + highlights reel
TIMELAPSE_INTERVAL=30
TIMELAPSE_SECONDS=60
TIMELAPSE_BUILD_AT=00:15
TIMELAPSE_KEEP_DAYS=14
HIGHLIGHT_SECONDS=4

# ---------- Shareable blurred copies ----------
SHARE_KEEP_DAYS=7
# "Blur strangers" keeps a face only when it matches the library this much above FACE_MATCH_THRESHOLD
SHARE_KNOWN_MARGIN=0.05

# ---------- Daily summary ----------
# Low-priority ntfy push with the day's visits at this local time (HH:MM). Empty = off
DAILY_SUMMARY_TIME=21:00

# ---------- Optional: copy starred clips to iCloud Drive (extras/icloud-sync.sh) ----------
# SMB share that is the iCloudDrive\Camwatch folder on a Windows PC, e.g. //192.168.1.20/camwatch. Empty = off
ICLOUD_SHARE=
# smbclient auth file (mode 600) with "username = ..." and "password = ..."
ICLOUD_CRED=/etc/camwatch-icloud.cred
