<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>DanteStreamerController</RootNamespace>
    <AssemblyName>DanteStreamerController</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>DanteStreamer Project</Authors>
    <Description>Native Windows control application for DanteStreamer</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
  </ItemGroup>

</Project>
