<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>DanteStreamerController</RootNamespace>
    <AssemblyName>DanteStreamerController</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>DanteStreamer Project</Authors>
    <Description>Native Windows control application for DanteStreamer</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

</Project>
