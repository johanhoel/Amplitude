<Window x:Class="DanteStreamerController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DanteStreamer Controller" Height="640" Width="940" MinWidth="720" MinHeight="480"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <DataTemplate x:Key="MeterTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Position, Mode=OneWay}" Height="12" Foreground="#4CAF50"/>
                <TextBlock Grid.Column="2" Text="{Binding Level}" Foreground="#666" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: saved instances and the add form -->
        <Border Grid.Column="0" Background="White" BorderThickness="0,0,1,0" BorderBrush="#E0E0E0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,12,12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+ Add" Command="{Binding ToggleAddFormCommand}" Padding="8,2"/>
                        <TextBlock Text="Instances" FontSize="14" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Padding="12" Background="#FAFAFA" BorderThickness="0,1"
                        BorderBrush="#E0E0E0" Visibility="{Binding ShowAddForm, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Name (optional)" Foreground="#666"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="Host or IP" Foreground="#666"/>
                        <TextBox Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="Port" Foreground="#666"/>
                        <TextBox Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="Remote password (blank for localhost)" Foreground="#666"/>
                        <PasswordBox x:Name="NewPasswordBox" PasswordChanged="NewPasswordBox_PasswordChanged" Margin="0,2,0,10"/>
                        <Button Content="Save" Command="{Binding SaveInstanceCommand}"
                                Padding="8,4" Background="#2196F3" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="12" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Edit" Command="{Binding EditSelectedCommand}" Padding="8,4" Margin="0,0,8,0"/>
                        <Button Content="Remove" Command="{Binding RemoveInstanceCommand}" Padding="8,4"/>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                         BorderThickness="0" Background="White" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock FontSize="11" Foreground="#999">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}:{1}">
                                            <Binding Path="Host"/>
                                            <Binding Path="Port"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main panel -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="#FFEBEE" Padding="12,8"
                    Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap"/>
            </Border>

            <Grid>
                <TextBlock Text="Add or select an instance" FontSize="16" FontWeight="Bold" Foreground="#999"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Status, Converter={StaticResource NullToVis}}"/>

                <TabControl Margin="12" Visibility="{Binding Status, Converter={StaticResource NotNullToVis}}">
                    <TabItem Header="Status" Padding="12,4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Device" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Device.Name}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="1" Text="Engine" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.State}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="2" Text="Network" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} ({1})">
                                                    <Binding Path="Status.Device.Address"/>
                                                    <Binding Path="Status.Device.Interface"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Grid.Row="3" Text="Virgil version" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status.Version}" Style="{StaticResource Value}"/>
                                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource ToolButton}"/>
                                            <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource ToolButton}"/>
                                            <Button Content="Restart audio" Command="{Binding RestartCommand}" Style="{StaticResource ToolButton}"/>
                                            <Button Content="Open web panel" Command="{Binding OpenPanelCommand}" Style="{StaticResource ToolButton}"
                                                    ToolTip="Settings, routing and diagnostics in Virgil's own panel"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Clock" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Clock.State}" Style="{StaticResource Value}"
                                                   Foreground="{Binding Status.ClockLocked, Converter={StaticResource BoolToColor}}"/>
                                        <TextBlock Grid.Row="1" Text="Clock leader" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.Clock.Grandmaster}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="2" Text="Sample rate" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.Device.SampleRate, StringFormat='{}{0} Hz'}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="3" Text="Channels" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status.ChannelsText}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="4" Text="Dropouts (last hour)" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status.DropoutsLastHour}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="5" Text="Apps" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Status.AppsText}" Style="{StaticResource Value}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Meters" Padding="12,4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Transmit (TX). AirPlay plays on channels 1 and 2." FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding TxMeters}" ItemTemplate="{StaticResource MeterTemplate}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Receive (RX)" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding RxMeters}" ItemTemplate="{StaticResource MeterTemplate}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Scale: -60 to 0 dBFS" Foreground="#999"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
