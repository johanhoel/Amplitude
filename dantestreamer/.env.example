# Copy to .env and edit, then apply with: docker compose up -d
# (.env is not committed, so each machine can have its own names)

# Name in Dante Controller: letters, digits, '-', '_' and spaces, max 31.
# Give each DanteStreamer its own name, e.g. by room.
DEVICE_NAME=DanteStreamer

# Name your phone shows for AirPlay. Empty = same as DEVICE_NAME.
AIRPLAY_NAME=

# Dante channel names, comma-separated, in channel order (max 31 characters
# each, no = . @ "). Empty = keep the current names (TX n / RX n, or what
# was renamed in Dante Controller). Skip a channel with an empty entry.
# AirPlay plays on TX 1 (left) and TX 2 (right).
TX_CHANNEL_NAMES=AirPlay L,AirPlay R
RX_CHANNEL_NAMES=

# Remote access for the DanteStreamer desktop apps and for the web panel
# from other computers. Set a password of at least 8 characters (no spaces
# or "), then run: docker compose up -d
# The apps then connect to this computer's IP address with this password.
# Plain HTTP: use it only on your own network or over a VPN.
# Empty = leave remote access as it is (off unless turned on in the panel).
REMOTE_PASSWORD=
