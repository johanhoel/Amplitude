<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_people" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#f6f4fb" android:textSize="15sp" android:text="Home Deck" />
        <TextView android:id="@+id/w_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="12dp" android:textColor="#7d8794" android:textSize="17sp" android:text="⟳" />
    </LinearLayout>
    <TextView android:id="@+id/w_bus" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:textColor="#cbd5e1" android:textSize="13sp" android:fontFamily="monospace" />
    <TextView android:id="@+id/w_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#6b7280" android:textSize="11sp" />
</LinearLayout>
