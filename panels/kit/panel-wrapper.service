[Unit]
Description=Home Deck - panels for Home Assistant (port 80)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=panel-wrapper
Environment=HOME=/var/lib/panel-wrapper
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/opt/panel-wrapper/venv/bin/python3 /opt/panel-wrapper/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
