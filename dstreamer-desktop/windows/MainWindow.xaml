<Window x:Class="DStreamerController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DStreamer Controller" Height="640" Width="940" MinWidth="720" MinHeight="480"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <DataTemplate x:Key="MeterTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Position, Mode=OneWay}" Height="12" Foreground="#4CAF50"/>
                <TextBlock Grid.Column="2" Text="{Binding Level}" Foreground="#666" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: saved instances and the add form -->
        <Border Grid.Column="0" Background="White" BorderThickness="0,0,1,0" BorderBrush="#E0E0E0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,12,12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+ Add" Command="{Binding ToggleAddFormCommand}" Padding="8,2"/>
                        <TextBlock Text="Instances" FontSize="14" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Padding="12" Background="#FAFAFA" BorderThickness="0,1"
                        BorderBrush="#E0E0E0" Visibility="{Binding ShowAddForm, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Button Content="Find on network" Command="{Binding FindCommand}" Padding="8,4" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding FindMessage}" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6"
                                   Visibility="{Binding FindMessage, Converter={StaticResource NotNullToVis}}"/>
                        <ListBox ItemsSource="{Binding FoundHosts}" SelectedItem="{Binding SelectedFound}" MaxHeight="90" Margin="0,0,0,8"
                                 Visibility="{Binding FoundHosts.Count, Converter={StaticResource CountToVis}}"/>
                        <TextBlock Text="Name (optional)" Foreground="#666"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="Host or IP" Foreground="#666"/>
                        <TextBox Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="Port" Foreground="#666"/>
                        <TextBox Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="Password (REMOTE_PASSWORD; blank for this computer)" Foreground="#666" TextWrapping="Wrap"/>
                        <PasswordBox x:Name="NewPasswordBox" PasswordChanged="NewPasswordBox_PasswordChanged" Margin="0,2,0,10"/>
                        <TextBlock Margin="0,0,0,8"><Hyperlink Command="{Binding OpenGuideCommand}">How do I connect?</Hyperlink></TextBlock>
                        <Button Content="Save" Command="{Binding SaveInstanceCommand}"
                                Padding="8,4" Background="#2196F3" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="12" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Edit" Command="{Binding EditSelectedCommand}" Padding="8,4" Margin="0,0,8,0"/>
                        <Button Content="Remove" Command="{Binding RemoveInstanceCommand}" Padding="8,4"/>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                         BorderThickness="0" Background="White" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock FontSize="11" Foreground="#999">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}:{1}">
                                            <Binding Path="Host"/>
                                            <Binding Path="Port"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main panel -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="#FFEBEE" Padding="12,8"
                    Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap"/>
            </Border>

            <Grid>
                <!-- Start page: shown until a DStreamer answers -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Status, Converter={StaticResource NullToVis}}">
                    <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Set up DStreamer" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedInstance.Name, StringFormat='Connecting to {0}...'}" Foreground="#666" Margin="0,0,0,12"
                                   Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#444" Margin="0,0,0,16"
                                   Text="DStreamer sends sound to Dante speakers and amplifiers. Pick the setup that matches yours."/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="A. This computer plays to the Dante speakers" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,10"
                                           Text="No other equipment needed: this PC joins the Dante network and sends its own sound (Spotify, a browser, everything) to the speakers."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="1. Click Install Virgil. Virgil is the free Dante engine DStreamer uses, and it comes with this app. Windows asks for permission once: click Yes. The app connects by itself when it is done."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="2. The Status tab then shows this PC on the Dante network. If Virgil was already installed, click Use this computer instead."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="3. Send the PC's sound to Dante: right-click the Virgil icon next to the clock, choose Desktop audio…, click Add…, pick Default output device (or one app, like spotify.exe) on transmit channels 1 and 2."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="4. In Dante Controller, route this PC's transmit channels 1 and 2 to your speakers."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding InstallButtonText}" Command="{Binding InstallVirgilCommand}" Style="{StaticResource ToolButton}"
                                            Background="#2196F3" Foreground="White" BorderThickness="0"/>
                                    <Button Content="Use this computer" Command="{Binding UseThisComputerCommand}" Style="{StaticResource ToolButton}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding InstallMessage}" TextWrapping="Wrap" Foreground="#1565C0" Margin="0,8,0,0"
                                           Visibility="{Binding InstallMessage, Converter={StaticResource NotNullToVis}}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#999" FontSize="11" Margin="0,8,0,0"
                                           Text="Virgil is free software under the GNU GPL v3. Source: github.com/Audbol/Virgil-Virtual-Soundcard"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="B. A DStreamer box on the network" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,10"
                                           Text="DStreamer already runs on another computer, for example a small Linux box that phones play to with AirPlay. That box needs remote access turned on once: REMOTE_PASSWORD in its .env file. The setup guide shows how."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Find on network" Command="{Binding FindFromStartCommand}" Style="{StaticResource ToolButton}"/>
                                    <Button Content="Setup guide" Command="{Binding OpenGuideCommand}" Style="{StaticResource ToolButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TabControl Margin="12" Visibility="{Binding Status, Converter={StaticResource NotNullToVis}}">
                    <TabItem Header="Status" Padding="12,4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Device" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Device.Name}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="1" Text="Engine" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.State}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="2" Text="Network" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} ({1})">
                                                    <Binding Path="Status.Device.Address"/>
                                                    <Binding Path="Status.Device.Interface"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Grid.Row="3" Text="Virgil version" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status.Version}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding ActionMessage}" Foreground="#1565C0" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding ActionMessage, Converter={StaticResource NotNullToVis}}"/>
                                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource ToolButton}"/>
                                            <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource ToolButton}"/>
                                            <Button Content="Restart audio" Command="{Binding RestartCommand}" Style="{StaticResource ToolButton}"/>
                                            <Button Content="Open web panel" Command="{Binding OpenPanelCommand}" Style="{StaticResource ToolButton}"
                                                    ToolTip="Settings, routing and diagnostics in Virgil's own panel"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Clock" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Clock.State}" Style="{StaticResource Value}"
                                                   Foreground="{Binding Status.ClockLocked, Converter={StaticResource BoolToColor}}"/>
                                        <TextBlock Grid.Row="1" Text="Clock leader" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.Clock.Grandmaster}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="2" Text="Sample rate" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.Device.SampleRate, StringFormat='{}{0} Hz'}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="3" Text="Channels" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status.ChannelsText}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="4" Text="Dropouts (last hour)" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status.DropoutsLastHour}" Style="{StaticResource Value}"/>
                                        <TextBlock Grid.Row="5" Text="Apps" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Status.AppsText}" Style="{StaticResource Value}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Meters" Padding="12,4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Transmit (TX). AirPlay plays on channels 1 and 2." FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding TxMeters}" ItemTemplate="{StaticResource MeterTemplate}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Receive (RX)" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <ItemsControl ItemsSource="{Binding RxMeters}" ItemTemplate="{StaticResource MeterTemplate}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Scale: -60 to 0 dBFS" Foreground="#999"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
